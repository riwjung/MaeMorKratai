{
  "manifest_version": 3,
  "name": "MaeMorKratai Gemini Card Runner",
  "version": "1.4.0",
  "description": "ส่งพรอมต์ไพ่พร้อมภาพต้นฉบับในแชท Gemini ที่เจ้าของเลือก โดยไม่ใช้ API",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "deck-data.js",
        "title-workflow.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/IMG_5392.JPG"
      ],
      "matches": [
        "https://gemini.google.com/*"
      ]
    }
  ]
}
