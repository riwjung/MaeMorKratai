[
  {
    "text": "คุณเป็นคนประเภทเดอะฟูล|ในที่ทำงานรึเปล่าคะ",
    "start": 0.0,
    "end": 2.285,
    "piece": 1
  },
  {
    "text": "ถ้าใช่ ไม่แย่เลยนะ|คนแบบนี้แพ้ยากที่สุดในออฟฟิศ",
    "start": 2.985,
    "end": 5.24,
    "piece": 2
  },
  {
    "text": "เพราะเขาทำงานแบบเป็นตัวเอง|ไม่เรื่องมาก อยากทำก็ทำ",
    "start": 5.69,
    "end": 8.456,
    "piece": 3
  },
  {
    "text": "ไม่สนกระแสใครว่า|แต่พอมีเทรนด์ใหม่",
    "start": 8.806,
    "end": 10.606046874999999,
    "piece": 4
  },
  {
    "text": "กลับไหลไปกับมันได้|อย่างแนบเนียน",
    "start": 10.606046874999999,
    "end": 12.296999999999999,
    "piece": 4
  },
  {
    "text": "สนุกของเขาไม่ใช่อู้งานนะคะ",
    "start": 12.747,
    "end": 14.17128,
    "piece": 5
  },
  {
    "text": "แต่คือจดจ่อจนลืมดูนาฬิกา",
    "start": 14.17128,
    "end": 15.485999999999999,
    "piece": 5
  },
  {
    "text": "ต่างจากผู้ใหญ่หลายคน|ที่ชอบนั่งจิบกาแฟ",
    "start": 16.037,
    "end": 17.971,
    "piece": 6
  },
  {
    "text": "มองลงมาจากบนหอคอย",
    "start": 18.271,
    "end": 19.546,
    "piece": 7
  },
  {
    "text": "มองคนข้างล่าง|ปล้ำกับกองงานยักษ์อย่างบ้าคลั่ง",
    "start": 19.896,
    "end": 22.267,
    "piece": 8
  },
  {
    "text": "แล้วบ่นว่า|ถ้าเป็นเราคงทำได้ดีกว่า",
    "start": 22.567,
    "end": 24.368,
    "piece": 9
  },
  {
    "text": "แต่เดอะฟูลต่างออกไปค่ะ|เขาเดินลงสนามเอง",
    "start": 24.969,
    "end": 27.247,
    "piece": 10
  },
  {
    "text": "แล้วแทนที่จะเครียด|เขากลับเปลี่ยนกองงานนั้นให้เป็นของเล่น",
    "start": 27.547,
    "end": 30.469,
    "piece": 11
  },
  {
    "text": "งานที่ดูน่ากลัว|เลยกลายเป็นเรื่องสนุก",
    "start": 30.868,
    "end": 32.437999999999995,
    "piece": 12
  },
  {
    "text": "พังก็ขำ แผนเปลี่ยนก็ปรับ",
    "start": 32.688,
    "end": 34.177,
    "piece": 13
  },
  {
    "text": "เพราะคนนั่งดูได้แค่ความเห็น",
    "start": 34.627,
    "end": 36.09620754716981,
    "piece": 14
  },
  {
    "text": "ส่วนคนลงสนามได้ฝีมือกลับไป",
    "start": 36.09620754716981,
    "end": 37.511,
    "piece": 14
  },
  {
    "text": "และพลังวิเศษอันดับหนึ่งของเขาคือ",
    "start": 38.111,
    "end": 39.965999999999994,
    "piece": 15
  },
  {
    "text": "เขาไม่กลัวที่จะดูโง่|ในสายตาคนอื่นค่ะ",
    "start": 40.766,
    "end": 42.667,
    "piece": 16
  },
  {
    "text": "คำถามที่ทุกคนไม่กล้าถาม|เขาถามก่อน",
    "start": 43.067,
    "end": 44.8952,
    "piece": 17
  },
  {
    "text": "ทั้งทีมเลยเข้าใจไปด้วย",
    "start": 44.8952,
    "end": 46.114000000000004,
    "piece": 17
  },
  {
    "text": "ถ้าคุณเป็นเดอะฟูลในออฟฟิศ|แท็กเพื่อน",
    "start": 46.714,
    "end": 48.71884375,
    "piece": 18
  },
  {
    "text": "แล้วกดติดตามแม่หมอกระต่ายนะคะ",
    "start": 48.71884375,
    "end": 50.379999999999995,
    "piece": 18
  },
  {
    "text": "ฝากกดไลก์ กดแชร์|และกดติดตามแม่หมอกระต่ายด้วยนะคะ",
    "start": 50.98,
    "end": 53.897999999999996,
    "piece": 19
  }
]